{
  "name": "rpg-bot",
  "version": "1.0.0",
  "description": "Butterfly Effect Permadeath RPG Discord Bot",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --experimental-sqlite dist/index.js",
    "dev": "node --experimental-sqlite -r ts-node/register src/index.ts",
    "deploy": "node --experimental-sqlite -r ts-node/register src/deploy.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "doctor": "node --experimental-sqlite -r ts-node/register src/doctor.ts"
  },
  "dependencies": {
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9"
  }
}
